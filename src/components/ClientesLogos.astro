---
const clientes = [
  { nombre: "Delfingen", logo: "/clientes/delfingen.svg" },
  { nombre: "FAG", logo: "/clientes/fag.svg" },
  { nombre: "Gamesa", logo: "/clientes/gamesa.svg" },
  { nombre: "Hutchinson", logo: "/clientes/hutchinson.svg" },
  { nombre: "INA", logo: "/clientes/ina.svg" },
  { nombre: "LUK", logo: "/clientes/luk.svg" },
  { nombre: "Nestlé", logo: "/clientes/nestle.svg" },
  { nombre: "Schaeffler", logo: "/clientes/schaeffler.svg" },
  { nombre: "Standard Profil", logo: "/clientes/standard-profil.svg" },
  { nombre: "Yutaka", logo: "/clientes/yutaka.svg" },
];
---

<section class="section relative overflow-hidden">
  <!-- Numero decorativo gigante en la esquina superior derecha -->
  <div
    class="absolute top-8 right-4 md:right-12 text-[120px] md:text-[200px] font-bold text-primary-100 leading-none select-none pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <div class="container-base relative z-10">
    <!-- Encabezado -->
    <div class="max-w-3xl mb-12 md:mb-16">
      <h2 class="section-title reveal">Nuestros clientes</h2>
      <p class="text-lg text-primary-700 reveal">
        Cada uno de nuestros clientes representa una estrecha relación de
        trabajo y crecimiento mutuo. Todo con un mismo objetivo, <strong
          >mejora continua</strong
        >. Cumpliendo con los más altos estándares de calidad, seguridad y de
        medio ambiente.
      </p>
    </div>

    <!-- Grid de logos -->
    <div
      class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 md:gap-12 items-center"
    >
      {
        clientes.map((cliente) => (
          <div
            class="w-full h-24 flex items-center justify-center p-4 reveal grayscale hover:grayscale-0 opacity-70 hover:opacity-100 transition-all duration-500"
            title={cliente.nombre}
          >
            <img
              src={cliente.logo}
              alt={`Logo de ${cliente.nombre}`}
              class="w-full h-full object-contain"
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
