---
const year = new Date().getFullYear();

const empresa = {
  nombre: "Desarrollo Integral De Proyectos",
  email: "brandlopb@gmail.com",
  email2: "ricardoflores5@prodigy.net.mx",
  direccion: "Cobre #111 Col. Zona de Oro II C.P. 38020 Celaya, Gto.",
  redes: {
    linkedin: "https://linkedin.com/company/tu-empresa",
    facebook: "https://facebook.com/tu-empresa",
    instagram: "https://instagram.com/tu-empresa",
  },
};
---

<footer class="bg-primary-900 text-primary-100">
  <div class="container-base py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Columna 1: Logo y descripcion -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
            <img src="/logo/logo-dip-white.svg" alt="Logo Empresa" class="h-14 w-auto bg-white p-2 rounded-full hover:scale-105 transition transform" />
          <span class="font-display font-bold text-xl text-white">
            {empresa.nombre}
          </span>
        </div>
        <div class="flex gap-3">
          <a
            href={empresa.redes.linkedin}
            target="_blank"
            rel="noopener"
            class="w-10 h-10 bg-primary-800 rounded-full flex items-center justify-center hover:bg-accent transition-colors"
            aria-label="LinkedIn"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              ></path>
            </svg>
          </a>
          <a
            href={empresa.redes.facebook}
            target="_blank"
            rel="noopener"
            class="w-10 h-10 bg-primary-800 rounded-full flex items-center justify-center hover:bg-accent transition-colors"
            aria-label="Facebook"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"
              ></path>
            </svg>
          </a>
          <a
            href={empresa.redes.instagram}
            target="_blank"
            rel="noopener"
            class="w-10 h-10 bg-primary-800 rounded-full flex items-center justify-center hover:bg-accent transition-colors"
            aria-label="Instagram"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Columna 2: Enlaces rapidos -->
      <div>
        <h3 class="text-white font-bold mb-4">Empresa</h3>
        <ul class="space-y-2">
          <li>
            <a href="/nosotros" class="hover:text-accent transition-colors"
              >Nosotros</a
            >
          </li>
          <li>
            <a href="/servicios" class="hover:text-accent transition-colors"
              >Servicios</a
            >
          </li>
          <li>
            <a href="/proyectos" class="hover:text-accent transition-colors"
              >Proyectos</a
            >
          </li>
          <li>
            <a href="/contacto" class="hover:text-accent transition-colors"
              >Contacto</a
            >
          </li>
        </ul>
      </div>

      <!-- Columna 3: Contacto -->
      <div>
        <h3 class="text-white font-bold mb-4">Contacto</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href={`mailto:${empresa.email}`}
              class="hover:text-accent transition-colors"
            >
              {empresa.email}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${empresa.email}`}
              class="hover:text-accent transition-colors"
            >
              {empresa.email2}
            </a>
          </li>
          <li class="pt-2 text-primary-300">
            {empresa.direccion}
          </li>
        </ul>
      </div>
    </div>

    <!-- Linea inferior -->
    <div
      class="border-t border-primary-800 mt-12 pt-8 flex flex-col md:flex-row justify-center items-center gap-4 text-sm text-primary-400"
    >
      <p>© {year} {empresa.nombre}. Todos los derechos reservados.</p>

    </div>
  </div>
</footer>
