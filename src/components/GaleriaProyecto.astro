---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
 
export interface Props {
  imagenes: ImageMetadata[];
  titulo?: string;
}
 
const { imagenes, titulo } = Astro.props;
---
 
<div class="my-12">
  {titulo && <h3 class="text-2xl font-bold mb-6">{titulo}</h3>}
 
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {imagenes.map((img, idx) => (
<button
        class="galeria-item img-zoom aspect-square rounded-lg overflow-hidden cursor-pointer reveal group relative"
        data-index={idx}
        data-src={img.src}
        aria-label={`Ver imagen ${idx + 1} en grande`}
>
<Image
          src={img}
          alt={`Imagen ${idx + 1}`}
          class="w-full h-full object-cover"
          widths={[400, 800]}
          sizes="(max-width: 768px) 100vw, 33vw"
        />
<!-- Overlay con icono al hover -->
<div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-all duration-300 flex items-center justify-center">
<svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-12 h-12 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-300"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
>
<circle cx="11" cy="11" r="8"></circle>
<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
<line x1="11" y1="8" x2="11" y2="14"></line>
<line x1="8" y1="11" x2="14" y2="11"></line>
</svg>
</div>
</button>
    ))}
</div>
</div>
 
<!-- LIGHTBOX (modal de imagen grande) -->
<div
  id="lightbox"
  class="fixed inset-0 z-[100] bg-black/95 hidden items-center justify-center p-4 animate-fade-in"
  role="dialog"
  aria-modal="true"
  aria-label="Visor de imagen ampliada"
>
<!-- Botón cerrar -->
<button
    id="lightbox-close"
    class="absolute top-4 right-4 w-12 h-12 bg-white/10 hover:bg-white/20 text-white rounded-full flex items-center justify-center transition-all hover:scale-110 z-10"
    aria-label="Cerrar"
>
<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<line x1="18" y1="6" x2="6" y2="18"></line>
<line x1="6" y1="6" x2="18" y2="18"></line>
</svg>
</button>
 
  <!-- Botón anterior -->
<button
    id="lightbox-prev"
    class="absolute left-4 top-1/2 -translate-y-1/2 w-12 h-12 bg-white/10 hover:bg-white/20 text-white rounded-full flex items-center justify-center transition-all hover:scale-110 z-10"
    aria-label="Imagen anterior"
>
<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<polyline points="15 18 9 12 15 6"></polyline>
</svg>
</button>
 
  <!-- Botón siguiente -->
<button
    id="lightbox-next"
    class="absolute right-4 top-1/2 -translate-y-1/2 w-12 h-12 bg-white/10 hover:bg-white/20 text-white rounded-full flex items-center justify-center transition-all hover:scale-110 z-10"
    aria-label="Imagen siguiente"
>
<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
<polyline points="9 18 15 12 9 6"></polyline>
</svg>
</button>
 
  <!-- Imagen ampliada -->
<img
    id="lightbox-img"
    src=""
    alt=""
    class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg shadow-2xl"
  />
 
  <!-- Contador (1 de 5) -->
<div
    id="lightbox-counter"
    class="absolute bottom-6 left-1/2 -translate-x-1/2 bg-white/10 text-white px-4 py-2 rounded-full text-sm font-medium"
>
    1 / 1
</div>
</div>
 
<script>
  // ============================================
  // LIGHTBOX - Visor de imágenes ampliadas
  // ============================================
  const setupLightbox = () => {
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const counter = document.getElementById('lightbox-counter');
    const btnClose = document.getElementById('lightbox-close');
    const btnPrev = document.getElementById('lightbox-prev');
    const btnNext = document.getElementById('lightbox-next');
 
    if (!lightbox || !lightboxImg) return;
 
    // Recolectar todas las imágenes de la galería
    const items = Array.from(document.querySelectorAll('.galeria-item')) as HTMLElement[];
    if (items.length === 0) return;
 
    let currentIndex = 0;
 
    const abrirLightbox = (index: number) => {
      currentIndex = index;
      const item = items[index];
      const src = item.getAttribute('data-src') || '';
      lightboxImg.src = src;
      lightboxImg.alt = `Imagen ${index + 1}`;
      if (counter) counter.textContent = `${index + 1} / ${items.length}`;
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden'; // Bloquear scroll del fondo
    };
 
    const cerrarLightbox = () => {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = ''; // Restaurar scroll
    };
 
    const siguiente = () => {
      const nuevoIndex = (currentIndex + 1) % items.length;
      abrirLightbox(nuevoIndex);
    };
 
    const anterior = () => {
      const nuevoIndex = (currentIndex - 1 + items.length) % items.length;
      abrirLightbox(nuevoIndex);
    };
 
    // Eventos de cada miniatura
    items.forEach((item, idx) => {
      item.addEventListener('click', () => abrirLightbox(idx));
    });
 
    // Botones del lightbox
    btnClose?.addEventListener('click', cerrarLightbox);
    btnNext?.addEventListener('click', siguiente);
    btnPrev?.addEventListener('click', anterior);
 
    // Cerrar al hacer clic fuera de la imagen
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) cerrarLightbox();
    });
 
    // Atajos de teclado
    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') cerrarLightbox();
      if (e.key === 'ArrowRight') siguiente();
      if (e.key === 'ArrowLeft') anterior();
    });
  };
 
  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>