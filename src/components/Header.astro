---
const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/servicios", label: "Servicios" },
  { href: "/proyectos", label: "Proyectos" },
  { href: "/clientes", label: "Clientes" },
  { href: "/contacto", label: "Contacto" },
];

const currentPath = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 bg-white/95 backdrop-blur-sm border-b border-primary-100 transition-all"
>
  <div class="container-base">
    <nav class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <img
          src="/logo/logo-dip.svg"
          alt="Logo Empresa"
          class="h-20 w-auto hover:scale-105 transition transform"
        />
      </a>

      <!-- Navegacion desktop -->
      <ul class="hidden lg:flex items-center gap-8">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  "font-medium transition-colors hover:text-accent",
                  currentPath === item.href
                    ? "text-accent"
                    : "text-primary-700",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- CTA desktop -->
      <a
        href="/contacto"
        class="hidden lg:inline-flex btn-primary !py-2 !px-5 text-sm"
      >
        Cotizar proyecto
      </a>

      <!-- Boton menu movil -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-primary-900"
        aria-label="Abrir menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </nav>

    <!-- Menu movil -->
    <div id="mobile-menu" class="hidden lg:hidden pb-6">
      <ul class="flex flex-col gap-4">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="block py-2 text-primary-700 font-medium hover:text-accent"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="pt-4 border-t border-primary-100">
          <a href="/contacto" class="btn-primary w-full">Cotizar proyecto</a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    // Bandera para evitar duplicar listeners
    if (window.__mobileMenuSetup) return;
    window.__mobileMenuSetup = true;

    document.addEventListener("click", function (e) {
      const target = e.target;
      if (!target) return;

      // Si el click fue en el boton o algo dentro de el
      const btn = target.closest("#mobile-menu-btn");
      if (btn) {
        const menu = document.getElementById("mobile-menu");
        if (menu) {
          menu.classList.toggle("hidden");
        }
        return;
      }

      // Si el click fue en un link del menu movil, cerrar
      const link = target.closest("#mobile-menu a");
      if (link) {
        const menu = document.getElementById("mobile-menu");
        if (menu) menu.classList.add("hidden");
      }
    });

    // Cerrar el menu cuando cambia de pagina con View Transitions
    document.addEventListener("astro:before-preparation", function () {
      const menu = document.getElementById("mobile-menu");
      if (menu) menu.classList.add("hidden");
    });
  })();
</script>
