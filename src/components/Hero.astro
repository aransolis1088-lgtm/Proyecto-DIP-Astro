---
export interface Props {
  titulo: string;
  subtitulo: string;
  imagenFondo?: string;
  ctaPrimario?: { texto: string; href: string };
  ctaSecundario?: { texto: string; href: string };
}

const {
  titulo,
  subtitulo,
  imagenFondo = '/hero-default.jpg',
  ctaPrimario = { texto: 'Solicitar cotización', href: '/contacto' },
  ctaSecundario = { texto: 'Ver proyectos', href: '/proyectos' },
} = Astro.props;
---

<section class="relative min-h-[90vh] flex items-center overflow-hidden">
  <!-- Imagen de fondo -->
  <div
    class="absolute inset-0 bg-cover bg-center"
    style={`background-image: url('${imagenFondo}')`}
  >
    <div class="absolute inset-0 bg-gradient-to-r from-primary-900/90 via-primary-900/70 to-primary-900/40"></div>
  </div>

  <!-- Contenido -->
  <div class="container-base relative z-10 py-20">
    <div class="max-w-3xl text-white">
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold leading-tight mb-6 reveal">
        {titulo}
      </h1>
      <p class="text-xl md:text-2xl text-primary-100 mb-10 max-w-2xl reveal">
        {subtitulo}
      </p>
      <div class="flex flex-wrap gap-4 reveal">
        <a href={ctaPrimario.href} class="btn-primary">
          {ctaPrimario.texto}
        </a>
        <a
          href={ctaSecundario.href}
          class="inline-flex items-center justify-center px-6 py-3 bg-white/10 backdrop-blur text-white font-semibold rounded-lg border-2 border-white/30 hover:bg-white/20 transition-all"
        >
          {ctaSecundario.texto}
        </a>
      </div>
    </div>
  </div>

  <!-- Indicador de scroll -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white animate-bounce">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M7 13l5 5 5-5M7 6l5 5 5-5"/>
    </svg>
  </div>
</section>
