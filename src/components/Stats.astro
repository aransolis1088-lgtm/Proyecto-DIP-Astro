---
const stats = [
  { numero: "30+", label: "Años de experiencia" },
  { numero: "100+", label: "Proyectos entregados" },
  { numero: "50+", label: "Clientes corporativos" },
  { numero: "100%", label: "Cumplimiento de plazos" },
];
---

<section class="bg-primary-900 text-white py-16">
  <div class="container-base">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {
        stats.map((stat) => (
          <div class="reveal">
            <div class="text-4xl md:text-5xl font-bold text-accent mb-2">
              {stat.numero}
            </div>
            <div class="text-primary-200 uppercase tracking-wide text-sm">
              {stat.label}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
