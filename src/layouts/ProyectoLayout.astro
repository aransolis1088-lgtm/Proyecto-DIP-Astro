---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  proyecto: CollectionEntry<'proyectos'>;
}

const { proyecto } = Astro.props;
const { data } = proyecto;
---

<BaseLayout
  title={`${data.titulo} | Proyectos`}
  description={data.descripcionCorta}
>
  <!-- Hero del proyecto -->
  <section class="relative h-[70vh] min-h-[500px] overflow-hidden">
    <Image
      src={data.fotoPortada}
      alt={data.titulo}
      class="absolute inset-0 w-full h-full object-cover"
      widths={[800, 1200, 1920]}
      sizes="100vw"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-primary-900/90 via-primary-900/50 to-transparent"></div>

    <div class="absolute inset-x-0 bottom-0 container-base pb-16">
      <div class="max-w-3xl text-white">
        <span class="inline-block px-3 py-1 bg-accent rounded text-sm font-semibold mb-4">
          {data.tipo.toUpperCase()}
        </span>
        <h1 class="text-4xl md:text-6xl font-bold mb-4">{data.titulo}</h1>
        <p class="text-xl text-primary-100">{data.descripcionCorta}</p>
      </div>
    </div>
  </section>

  <!-- Datos clave del proyecto -->
  <section class="bg-primary-50 py-12">
    <div class="container-base">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <p class="text-sm text-primary-600 uppercase tracking-wide">Cliente</p>
          <p class="text-xl font-bold text-primary-900 mt-1">{data.cliente}</p>
        </div>
        <div>
          <p class="text-sm text-primary-600 uppercase tracking-wide">Ubicación</p>
          <p class="text-xl font-bold text-primary-900 mt-1">{data.ubicacion}</p>
        </div>
        <div>
          <p class="text-sm text-primary-600 uppercase tracking-wide">Año</p>
          <p class="text-xl font-bold text-primary-900 mt-1">{data.ano}</p>
        </div>
        <div>
          <p class="text-sm text-primary-600 uppercase tracking-wide">Duración</p>
          <p class="text-xl font-bold text-primary-900 mt-1">{data.duracion}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contenido del proyecto (viene del .mdx) -->
  <article class="section">
    <div class="container-base max-w-4xl">
      <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:text-primary-900 prose-a:text-accent">
        <slot />
      </div>
    </div>
  </article>

  <!-- CTA al final -->
  <section class="bg-primary-900 text-white section">
    <div class="container-base text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">¿Tienes un proyecto similar?</h2>
      <p class="text-xl text-primary-200 mb-8">Hablemos sobre cómo podemos ayudarte</p>
      <a href="/contacto" class="btn-primary">Solicitar cotización</a>
    </div>
  </section>
</BaseLayout>
