---
import BaseLayout from "@layouts/BaseLayout.astro";

const empresa = {
  telefono: "+52 461 308 4922",
  email: "brandlopb@gmail.com",
  direccion: "Cobre #111 Col. Zona de Oro II, Celaya, Guanajuato, México",
  whatsapp: "5214613084922",
  horario: "Lunes a Viernes: 9:00 - 18:00",
};
---

<BaseLayout
  title="Contacto | Solicita una Cotización"
  description="Cuéntanos sobre tu proyecto. Respondemos cotizaciones en menos de 24 horas hábiles."
>
  <!-- Hero -->
  <section class="bg-primary-900 text-white py-24">
    <div class="container-base text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 reveal">
        Hablemos de tu proyecto
      </h1>
      <p class="text-xl text-primary-200 max-w-2xl mx-auto reveal">
        Contáctanos por el medio que prefieras. Respondemos en menos de 24 horas
        hábiles.
      </p>
    </div>
  </section>

  <!-- Contacto rápido -->
  <section class="section">
    <div class="container-base">
      <div class="grid md:grid-cols-3 gap-6 mb-16">
        <a
          href={`https://wa.me/${empresa.whatsapp}?text=Hola,%20me%20interesa%20cotizar%20un%20proyecto.`}
          target="_blank"
          rel="noopener"
          class="bg-green-500 hover:bg-green-600 text-white p-8 rounded-xl text-center transition-all hover:-translate-y-1 hover:shadow-xl reveal"
        >
          <div class="text-5xl mb-3">💬</div>
          <h3 class="text-xl font-bold mb-2">WhatsApp</h3>
          <p class="text-green-100">La forma más rápida de contactarnos</p>
        </a>

        <a
          href={`tel:${empresa.telefono.replace(/\s/g, "")}`}
          class="bg-primary-900 hover:bg-primary-800 text-white p-8 rounded-xl text-center transition-all hover:-translate-y-1 hover:shadow-xl reveal"
        >
          <div class="text-5xl mb-3">📞</div>
          <h3 class="text-xl font-bold mb-2">Teléfono</h3>
          <p class="text-primary-200">{empresa.telefono}</p>
        </a>

        <a
          href={`mailto:${empresa.email}`}
          class="bg-accent hover:bg-accent-dark text-white p-8 rounded-xl text-center transition-all hover:-translate-y-1 hover:shadow-xl reveal"
        >
          <div class="text-5xl mb-3">✉️</div>
          <h3 class="text-xl font-bold mb-2">Email</h3>
          <p class="text-orange-100">{empresa.email}</p>
        </a>
      </div>

      <!-- Formulario y datos -->
      <div class="grid md:grid-cols-2 gap-12">
        <!-- Formulario -->
        <div class="reveal">
          <h2 class="text-3xl font-bold text-primary-900 mb-6">
            Envíanos un mensaje
          </h2>

          <!--
            IMPORTANTE: Para que el formulario funcione necesitas un servicio.
            Recomendado: https://web3forms.com (gratis, 250 envios/mes)
            1. Registrate y obten tu access_key
            2. Reemplaza "TU_ACCESS_KEY" abajo
          -->
          <form
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-4"
          >
            <input
              type="hidden"
              name="access_key"
              value="852a5c09-b064-4f2b-94a6-ec88733d7b39"
            />
            <input
              type="hidden"
              name="subject"
              value="Nueva cotización desde el sitio"
            />

            <div>
              <label
                for="nombre"
                class="block text-sm font-medium text-primary-700 mb-1"
              >
                Nombre completo *
              </label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                required
                class="w-full px-4 py-3 border border-primary-200 rounded-lg focus:ring-2 focus:ring-accent focus:border-transparent transition"
              />
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <label
                  for="empresa"
                  class="block text-sm font-medium text-primary-700 mb-1"
                >
                  Empresa *
                </label>
                <input
                  type="text"
                  id="empresa"
                  name="empresa"
                  required
                  class="w-full px-4 py-3 border border-primary-200 rounded-lg focus:ring-2 focus:ring-accent focus:border-transparent transition"
                />
              </div>
              <div>
                <label
                  for="telefono"
                  class="block text-sm font-medium text-primary-700 mb-1"
                >
                  Teléfono
                </label>
                <input
                  type="tel"
                  id="telefono"
                  name="telefono"
                  class="w-full px-4 py-3 border border-primary-200 rounded-lg focus:ring-2 focus:ring-accent focus:border-transparent transition"
                />
              </div>
            </div>

            <div>
              <label
                for="email"
                class="block text-sm font-medium text-primary-700 mb-1"
              >
                Email *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-primary-200 rounded-lg focus:ring-2 focus:ring-accent focus:border-transparent transition"
              />
            </div>

            <div>
              <label
                for="tipo_proyecto"
                class="block text-sm font-medium text-primary-700 mb-1"
              >
                Tipo de proyecto *
              </label>
              <select
                id="tipo_proyecto"
                name="tipo_proyecto"
                required
                class="w-full px-4 py-3 border border-primary-200 rounded-lg focus:ring-2 focus:ring-accent focus:border-transparent transition"
              >
                <option value="">Selecciona una opción</option>
                <option value="industrial">Construcción industrial</option>
                <option value="comercial">Construcción comercial</option>
                <option value="oficinas">Remodelación de oficinas</option>
                <option value="mantenimiento">Mantenimiento</option>
                <option value="otro">Otro</option>
              </select>
            </div>

            <div>
              <label
                for="mensaje"
                class="block text-sm font-medium text-primary-700 mb-1"
              >
                Cuéntanos sobre tu proyecto *
              </label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="5"
                required
                class="w-full px-4 py-3 border border-primary-200 rounded-lg focus:ring-2 focus:ring-accent focus:border-transparent transition"
                placeholder="Describe el proyecto, ubicación, tiempos esperados..."
              ></textarea>
            </div>

            <button type="submit" class="btn-primary w-full">
              Enviar mensaje
            </button>
          </form>
        </div>

        <!-- Datos de contacto + mapa -->
        <div class="space-y-6 reveal">
          <h2 class="text-3xl font-bold text-primary-900 mb-6">
            Información de contacto
          </h2>

          <div class="space-y-4">
            <div class="flex gap-4">
              <div
                class="flex-shrink-0 w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center"
              >
                <span class="text-2xl">📍</span>
              </div>
              <div>
                <h3 class="font-bold text-primary-900">Dirección</h3>
                <p class="text-primary-600">{empresa.direccion}</p>
              </div>
            </div>

            <div class="flex gap-4">
              <div
                class="flex-shrink-0 w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center"
              >
                <span class="text-2xl">📞</span>
              </div>
              <div>
                <h3 class="font-bold text-primary-900">Teléfono</h3>
                <a
                  href={`tel:${empresa.telefono.replace(/\s/g, "")}`}
                  class="text-primary-600 hover:text-accent"
                >
                  {empresa.telefono}
                </a>
              </div>
            </div>

            <div class="flex gap-4">
              <div
                class="flex-shrink-0 w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center"
              >
                <span class="text-2xl">✉️</span>
              </div>
              <div>
                <h3 class="font-bold text-primary-900">Email</h3>
                <a
                  href={`mailto:${empresa.email}`}
                  class="text-primary-600 hover:text-accent"
                >
                  {empresa.email}
                </a>
              </div>
            </div>

            <div class="flex gap-4">
              <div
                class="flex-shrink-0 w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center"
              >
                <span class="text-2xl">🕐</span>
              </div>
              <div>
                <h3 class="font-bold text-primary-900">Horario</h3>
                <p class="text-primary-600">{empresa.horario}</p>
              </div>
            </div>
          </div>

          <!-- Mapa (reemplaza el src con tu ubicación de Google Maps) -->
          <div
            class="aspect-video rounded-xl overflow-hidden bg-primary-100 mt-8"
          >
            <iframe
              src="https://maps.google.com/maps?q=Celaya,Guanajuato,Mexico&t=&z=13&ie=UTF8&iwloc=&output=embed"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
