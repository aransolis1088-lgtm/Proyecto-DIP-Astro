---
import BaseLayout from "@layouts/BaseLayout.astro";

const valores = [
  {
    titulo: "Calidad",
    descripcion:
      "Materiales y procesos de primera. Sin atajos, sin compromisos.",
    icono: "⭐",
  },
  {
    titulo: "Cumplimiento",
    descripcion:
      "Entregamos cuando prometemos. La confiabilidad es nuestra reputación.",
    icono: "⏰",
  },
  {
    titulo: "Transparencia",
    descripcion: "Cotizaciones claras, comunicación constante, sin sorpresas.",
    icono: "🤝",
  },
  {
    titulo: "Seguridad",
    descripcion:
      "Protocolos rigurosos en cada obra. Cero accidentes es nuestro estándar.",
    icono: "🛡️",
  },
];
---

<BaseLayout
  title="Nosotros | DIP"
  description="Conoce nuestra historia, valores y al equipo detrás de los proyectos."
>
  <!-- Hero de la página -->
  <section class="bg-primary-900 text-white py-24">
    <div class="container-base text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 reveal">Sobre nosotros</h1>
      <p class="text-xl text-primary-200 max-w-2xl mx-auto reveal">
        Más de 30 años impulsando la eficiencia y calidad en la industria.
      </p>
    </div>
  </section>

  <!-- Historia -->
  <section class="section">
    <div class="container-base">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <h2 class="section-title">Nuestra historia</h2>
          <p class="text-lg text-primary-700 mb-4">
            Desde 1998, brindamos soluciones integrales en diseño, fabricación,
            instalación, reparación y montaje de maquinaria y equipo industrial.
            A lo largo de los años, hemos colaborado con empresas de los
            sectores automotriz, alimenticio y químico, consolidándonos como un
            aliado confiable en la región.
          </p>
          <p class="text-lg text-primary-700 mb-4">
            Nuestro crecimiento se ha basado en un equipo altamente capacitado y
            certificado, comprometido con ofrecer resultados efectivos, rápidos
            y de alta calidad en cada proyecto.
          </p>
          <p class="text-lg text-primary-700">
            Hoy mantenemos el mismo enfoque con el que iniciamos: garantizar la
            seguridad, cumplir con las normativas aplicables y ofrecer un
            servicio honesto, profesional y orientado a las necesidades de cada
            cliente.
          </p>
        </div>
        <div class="reveal">
          <!-- Imagen del equipo o de la empresa -->
          <div
            class="aspect-[4/3] bg-primary-100 rounded-xl flex items-center justify-center"
          >
            <img
              src="/sobre-nosotros.jpeg"
              alt="Foto sobre nosotos"
              class="rounded-xl shadow-xl hover:shadow-2xl transition"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Misión y Visión -->
  <section class="section bg-primary-50">
    <div class="container-base">
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white p-8 rounded-xl shadow-sm reveal">
          <h3 class="text-2xl font-bold text-accent mb-4">Misión</h3>
          <p class="text-lg text-primary-700">
            Otorgar a nuestros clientes servicios de ingeniería mediante un
            equipo humano comprometido y de primer nivel en cuanto a lo
            profesional. Cumplir con el más amplio estándar de calidad en cada
            detalle de lo construido es y será nuestro sello distintivo.
          </p>
        </div>
        <div class="bg-white p-8 rounded-xl shadow-sm reveal">
          <h3 class="text-2xl font-bold text-accent mb-4">Visión</h3>
          <p class="text-lg text-primary-700">
            Ser un referente en materia de ingeniería gracias a sus diseños
            innovadores y su compromiso con el medioambiente y sus necesidades.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Valores -->
  <section class="section">
    <div class="container-base">
      <div class="text-center mb-12">
        <h2 class="section-title reveal">Nuestros valores</h2>
        <p class="section-subtitle reveal">
          Los principios que guían cada proyecto que emprendemos.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          valores.map((valor) => (
            <div class="text-center p-8 bg-white border border-primary-100 rounded-xl hover:shadow-xl transition-shadow reveal">
              <div class="text-5xl mb-4">{valor.icono}</div>
              <h3 class="text-xl font-bold text-primary-900 mb-2">
                {valor.titulo}
              </h3>
              <p class="text-primary-600">{valor.descripcion}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-primary-900 text-white">
    <div class="container-base text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">
        ¿Listo para trabajar con nosotros?
      </h2>
      <a href="/contacto" class="btn-primary">Hablemos de tu proyecto</a>
    </div>
  </section>
</BaseLayout>
